DATABASE_URL="postgresql://usuario:password@host/basedatos?sslmode=require"
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# URL pública base (para los links que se envían por WhatsApp/correo)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# WhatsApp Cloud API (Meta) — developers.facebook.com > tu App > WhatsApp > API Setup
# Requiere plantillas de mensaje aprobadas por Meta (Business Manager > Message Templates)
# con estos nombres exactos y esta cantidad de variables {{1}}, {{2}}, etc:
#   solicitud_confirmada    → 2 variables: nombre, fecha
#   solicitud_rechazada     → 1 variable: nombre
#   cotizacion_lista        → 3 variables: nombre, numero, link
#   orden_completada        → 3 variables: nombre, numero, link
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_SOLICITUD_CONFIRMADA="solicitud_confirmada"
WHATSAPP_TEMPLATE_SOLICITUD_RECHAZADA="solicitud_rechazada"
WHATSAPP_TEMPLATE_COTIZACION_LISTA="cotizacion_lista"
WHATSAPP_TEMPLATE_ORDEN_COMPLETADA="orden_completada"

# Resend (correo) — resend.com > API Keys. RESEND_FROM_EMAIL debe ser de un dominio verificado
# en Resend, o usar el remitente de pruebas "onboarding@resend.dev" mientras se verifica el dominio.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Carbox <onboarding@resend.dev>"

# Anthropic (Claude) — console.anthropic.com > API Keys. Se usa para leer fotos de
# guías de despacho/facturas y extraer los productos al importar inventario.
ANTHROPIC_API_KEY=""
